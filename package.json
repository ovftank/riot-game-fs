{
    "dependencies": {
        "better-sqlite3": "12.2.0",
        "express": "5.1.0",
        "jsonwebtoken": "9.0.2",
        "puppeteer-ghost": "0.0.11",
        "socket.io": "4.8.1",
        "zod": "3.25.75"
    },
    "devDependencies": {
        "@eslint/js": "9.30.1",
        "@types/better-sqlite3": "7.6.13",
        "@types/eslint": "9.6.1",
        "@types/express": "5.0.3",
        "@types/jsonwebtoken": "9.0.10",
        "cross-env": "7.0.3",
        "eslint": "9.30.1",
        "globals": "16.3.0",
        "jiti": "2.4.2",
        "prettier": "3.6.2",
        "tsc-alias": "1.8.16",
        "tsx": "4.20.3",
        "typescript": "5.8.3",
        "typescript-eslint": "8.35.1"
    },
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc && tsc-alias && node -e \"require('fs').cpSync('src/static', 'dist/static', {recursive: true})\"",
        "dev": "tsx src/server.ts",
        "format": "prettier . --write",
        "lint": "eslint . && tsc --noEmit",
        "start": "cross-env NODE_ENV=production PORT=80 node dist/server.js"
    },
    "type": "module"
}
